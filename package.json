{
    "name": "better-trading-react",
    "version": "0.1.1",
    "private": true,
    "type": "module",
    "scripts": {
        "check:changelog": "tsx scripts/check-changelog.ts",
        "check:release": "node scripts/check-release.mjs",
        "prebuild": "npm run check:changelog",
        "prebuild:firefox": "npm run check:changelog",
        "prezip": "npm run check:changelog",
        "prezip:firefox": "npm run check:changelog",
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "postinstall": "wxt prepare",
        "prepare": "node scripts/setup-git-hooks.mjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fortawesome/free-brands-svg-icons": "^5.15.4",
        "@fortawesome/free-solid-svg-icons": "^5.15.4",
        "@tanstack/react-query": "^5.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-markdown": "^10.1.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.20.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@wxt-dev/module-react": "^1.0.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "tsx": "^4.23.15",
        "typescript": "^5.0.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "web-ext": "^10.8.0",
        "wxt": "^0.21.4"
    }
}
